# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Seoul
LOG_LEVEL=debug
ADMIN_WEB_PORT=3000
API_PORT=4000
NGINX_PORT=8080
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ATLAS_CSRF_COOKIE_NAME=atlas_admin_csrf
ATLAS_API_INTERNAL_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TRUST_PROXY=loopback, linklocal, uniquelocal

# Admin authentication
AUTH_LOGIN_FINGERPRINT_PEPPER=atlas-admin-login-fingerprint-local-secret
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_MFA_CHALLENGE_SECONDS=300
AUTH_MFA_ENCRYPTION_KEY_BASE64=YXRsYXMtbG9jYWwtbWZhLWVuY3J5cHRpb24ta2V5LTE=
AUTH_MFA_ENCRYPTION_KEY_VERSION=local-v1
AUTH_MFA_RECOVERY_CODE_PEPPER=atlas-admin-recovery-code-local-secret
AUTH_MFA_ISSUER=Atlas
AUTH_MFA_WINDOW_STEPS=1
AUTH_MFA_GRANT_SECONDS=120
AUTH_MFA_RECOVERY_CODE_COUNT=10
AUTH_MFA_FAILURE_THRESHOLD=5
AUTH_SESSION_FINGERPRINT_PEPPER=atlas-admin-session-fingerprint-local-secret
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_SESSION_TOUCH_SECONDS=60
AUTH_SESSION_MAX_ACTIVE=5
AUTH_SESSION_BIND_IP=false
AUTH_SESSION_COOKIE_NAME=atlas_admin_session
AUTH_CSRF_COOKIE_NAME=atlas_admin_csrf
AUTH_COOKIE_SECURE=false

# API Client authentication
API_KEY_PEPPER=atlas-api-key-local-pepper-change-me
API_KEY_USAGE_TOUCH_SECONDS=60


# Outbox, Webhook and Publication Scheduling
WEBHOOK_SECRET_ENCRYPTION_KEY_BASE64=YXRsYXMtbG9jYWwtd2ViaG9vay1rZXktMjAyNi0wMDA=
WEBHOOK_SECRET_ENCRYPTION_KEY_VERSION=local-v1
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE_NETWORK=true
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_ENDPOINT_FAILURE_THRESHOLD=5
OUTBOX_RELAY_POLL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
OUTBOX_RELAY_MAX_ATTEMPTS=10
EVENTING_QUEUE_CONCURRENCY=4
WEBHOOK_DELIVERY_POLL_MS=1000
WEBHOOK_DELIVERY_BATCH_SIZE=25
WEBHOOK_DELIVERY_CLAIM_TIMEOUT_SECONDS=300
WEBHOOK_RESPONSE_MAX_BYTES=4096
PUBLICATION_SCHEDULE_POLL_MS=1000
PUBLICATION_SCHEDULE_BATCH_SIZE=25
PUBLICATION_SCHEDULE_CLAIM_TIMEOUT_SECONDS=300

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-local-password
DATABASE_URL=postgresql://atlas:atlas-local-password@localhost:5432/atlas

# Redis / BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
SYSTEM_QUEUE_NAME=atlas-system
MEDIA_QUEUE_NAME=atlas-media
MEDIA_PROCESSING_CONCURRENCY=2

# Media processing limits
ASSET_PROCESSING_MAX_INPUT_BYTES=26214400
ASSET_PROCESSING_MAX_OUTPUT_BYTES=26214400
ASSET_PROCESSING_MAX_PIXELS=40000000
ASSET_PROCESSING_MAX_DIMENSION=12000
ASSET_PROCESSING_STALE_SECONDS=900

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=atlas-root
MINIO_ROOT_PASSWORD=atlas-root-local-password
MINIO_API_ACCESS_KEY=atlas-api
MINIO_API_SECRET_KEY=atlas-api-local-secret
MINIO_WORKER_ACCESS_KEY=atlas-worker
MINIO_WORKER_SECRET_KEY=atlas-worker-local-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=atlas-api
MINIO_SECRET_KEY=atlas-api-local-secret
MINIO_PRIVATE_BUCKET=atlas-private
MINIO_PROCESSING_BUCKET=atlas-processing
MINIO_PUBLIC_BUCKET=atlas-public
MINIO_PUBLIC_BASE_URL=http://localhost:8080/assets

# Backup jobs — use separate least-privilege credentials outside local development.
BACKUP_ROOT=/var/backups/atlas
BACKUP_RETENTION_DAYS=35
BACKUP_DATABASE_URL=postgresql://atlas_backup:change-me@localhost:5432/atlas
RESTORE_TEST_DATABASE_URL=postgresql://atlas_restore_test:change-me@localhost:5432/postgres
BACKUP_MINIO_ENDPOINT=http://localhost:9000
BACKUP_MINIO_ACCESS_KEY=atlas-backup
BACKUP_MINIO_SECRET_KEY=change-me
