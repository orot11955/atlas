{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "predev": "pnpm build:packages",
    "dev": "turbo run dev --parallel",
    "dev:admin": "pnpm build:packages && pnpm --filter @atlas/admin-web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @atlas/api dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @atlas/worker dev",
    "build": "turbo run build",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:server": "pnpm --filter @atlas/server build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:discovery && turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres redis minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v --remove-orphans",
    "infra:logs": "docker compose logs -f postgres redis minio",
    "stack:up": "pnpm infra:up && docker compose --profile app up -d --build admin-web api worker nginx",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f",
    "admin:bootstrap-owner": "pnpm build:server && pnpm --filter @atlas/database admin:bootstrap-owner",
    "db:migration:create": "pnpm --filter @atlas/database migration:create",
    "db:migration:generate": "pnpm build:server && pnpm --filter @atlas/database migration:generate",
    "db:migration:run": "pnpm build:server && pnpm --filter @atlas/database migration:run",
    "db:migration:revert": "pnpm build:server && pnpm --filter @atlas/database migration:revert",
    "db:migration:show": "pnpm build:server && pnpm --filter @atlas/database migration:show",
    "backup:postgres": "bash scripts/backup/postgres-backup.sh",
    "backup:restore-test": "bash scripts/backup/postgres-restore-test.sh",
    "backup:minio": "bash scripts/backup/minio-backup.sh",
    "backup:prune": "bash scripts/backup/prune-backups.sh",
    "backup:all": "bash scripts/backup/run-data-backup.sh",
    "test:discovery": "node --test scripts/testing/discovery.test.mjs && node scripts/testing/run-tests.mjs --inventory",
    "test:editor:fixture": "python3 -m unittest discover -s scripts/testing/browser -p test_fixture.py -v",
    "test:editor:browser": "python3 scripts/testing/browser/editor_browser.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
