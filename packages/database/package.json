{
  "name": "@atlas/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/testing/run-tests.mjs",
    "admin:bootstrap-owner": "ts-node --project tsconfig.json src/admin-owner-bootstrap-cli.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "ts-node --project tsconfig.json src/migration-cli.ts run",
    "migration:revert": "ts-node --project tsconfig.json src/migration-cli.ts revert",
    "migration:show": "ts-node --project tsconfig.json src/migration-cli.ts show"
  },
  "dependencies": {
    "@atlas/server": "workspace:*",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
